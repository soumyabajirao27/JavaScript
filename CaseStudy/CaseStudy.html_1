<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Department of CSE - SIT Nagpur</title>
    <style>
        :root {
            --primary: #0f172a;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #334155;
            --text-dark: #0f172a;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        /* Top Navbar */
        .navbar {
            background-color: var(--primary);
            color: white;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        .logo {
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
        }

        /* Hero Banner Section */
        .hero {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            color: white;
            padding: 60px 20px;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin: 0 0 10px 0;
            font-weight: 800;
        }

        .hero p {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Main Container */
        .main-container {
            max-width: 1100px;
            margin: -40px auto 40px auto;
            padding: 0 20px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        /* Content Card */
        .content-card {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
            text-align: center;
        }

        .content-card h2 {
            color: var(--text-dark);
            font-size: 1.8rem;
            margin-top: 0;
        }

        /* Call to Action Button */
        .cta-btn {
            display: inline-flex;
            align-items: center;
            background-color: var(--accent);
            color: white;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 25px;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
            transition: all 0.2s ease;
        }

        .cta-btn:hover {
            background-color: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);
        }

        .cta-btn span {
            margin-left: 8px;
            transition: transform 0.2s;
        }

        .cta-btn:hover span {
            transform: translateX(4px);
        }
    </style>
</head>
<body onload="showAlert()">

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">SIT NAGPUR</div>
        <div>Academic Year 2026-27</div>
    </nav>

    <!-- Hero Area -->
    <header class="hero">
        <h1>Welcome to SIT Nagpur</h1>
        <p>Shaping the future through innovation, research, and excellent engineering education.</p>
    </header>

    <!-- Core Content Container -->
    <main class="main-container">
        
        <!-- Quick Stats Overview -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">1200+</div>
                <div class="stat-label">Active Students</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">45+</div>
                <div class="stat-label">Expert Faculty</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">94%</div>
                <div class="stat-label">Placement Record</div>
            </div>
        </section>

        <!-- Department Hub -->
        <section class="content-card">
            <h2>Computer Science & Engineering Portal</h2>
            <p>Access your curriculum tracking tools, manage course registration profiles, review upcoming exam timetables, and securely update your academic portfolios from our unified digital hub.</p>
            
            <a href="student_info.html" class="cta-btn">
                Access Student Information Page <span>&rarr;</span>
            </a>
        </section>
    </main>

    <!-- JavaScript Alert Script -->
    <script>
        function showAlert() {
            alert("Welcome to SIT NAGPUR");
        }
    </script>

</body>
</html>
