<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Analytics Grading Dashboard</title>
    <style>
        /* Modern Design Tokens & Variables */
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.08);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            
            /* Dynamic Grade Colors */
            --color-a: #10b981; /* Emerald */
            --color-b: #3b82f6; /* Blue */
            --color-c: #8b5cf6; /* Purple */
            --color-d: #f59e0b; /* Amber */
            --color-f: #ef4444; /* Rose */
            
            --error-bg: rgba(239, 68, 68, 0.15);
            --error-border: #ef4444;
        }

        /* Reset & Base Layout */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body {
            background: var(--bg-gradient);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* Glassmorphism Portal Card */
        .portal-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            width: 100%;
            max-width: 440px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        /* Typography & Headings */
        .portal-header { text-align: center; margin-bottom: 32px; }
        .portal-header h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px; background: linear-gradient(to right, #fff, #94a3b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .portal-header p { color: var(--text-secondary); font-size: 14px; }

        /* Form Controls */
        .form-group { position: relative; margin-bottom: 24px; }
        .input-wrapper { position: relative; display: flex; align-items: center; }
        
        input[type="text"] {
            width: 100%;
            padding: 16px 20px;
            background: rgba(15, 23, 42, 0.6);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: var(--text-primary);
            font-size: 18px;
            font-weight: 600;
            outline: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        input[type="text"]:focus { border-color: #6366f1; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2); background: rgba(15, 23, 42, 0.8); }
        input[type="text"]::placeholder { color: #475569; font-weight: 400; }

        /* Custom Interactive Button */
        button {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            border: none;
            border-radius: 14px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            transition: all 0.2s ease;
        }
        button:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4); }
        button:active { transform: translateY(1px); }

        /* Validation Alert Message */
        .error-alert {
            display: none;
            background: var(--error-bg);
            border-left: 4px solid var(--error-border);
            color: #fca5a5;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
            margin-top: 12px;
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        /* Advanced Dynamic Result Display */
        .result-panel {
            display: none;
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            animation: fadeIn 0.5s ease forwards;
        }
        .badge-container { display: inline-flex; justify-content: center; align-items: center; width: 90px; height: 90px; border-radius: 50%; margin-bottom: 16px; box-shadow: 0 0 20px rgba(0,0,0,0.2); position: relative; }
        .badge-container::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; opacity: 0.2; }
        .grade-badge { font-size: 42px; font-weight: 800; color: white; }
        
        .score-display { font-size: 15px; color: var(--text-secondary); margin-bottom: 4px; }
        .status-text { font-size: 20px; font-weight: 600; letter-spacing: -0.2px; }

        /* System Dynamic Color Classes */
        .tier-a { background: var(--color-a); }.tier-a::after { border: 4px solid var(--color-a); }
        .tier-b { background: var(--color-b); }.tier-b::after { border: 4px solid var(--color-b); }
        .tier-c { background: var(--color-c); }.tier-c::after { border: 4px solid var(--color-c); }
        .tier-d { background: var(--color-d); }.tier-d::after { border: 4px solid var(--color-d); }
        .tier-f { background: var(--color-f); }.tier-f::after { border: 4px solid var(--color-f); }
        
        .text-tier-a { color: var(--color-a); }
        .text-tier-b { color: var(--color-b); }
        .text-tier-c { color: var(--color-c); }
        .text-tier-d { color: var(--color-d); }
        .text-tier-f { color: var(--color-f); }

        /* Structural Animations */
        @keyframes cubic-bezier {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

<div class="portal-card">
    <div class="portal-header">
        <h1>Grading Analytics</h1>
        <p>SOUMYA BAJIRAO 24070521146</p>
    </div>

    <form id="gradingForm" novalidate>
        <div class="form-group">
            <div class="input-wrapper">
                <input type="text" id="marksInput" placeholder="Enter total marks (0 - 100)" autocomplete="off">
            </div>
            <div id="errorAlert" class="error-alert"></div>
        <button type="submit">Process Evaluation</button>
    </form>

    <!-- Structural Result Display Component -->
    <div id="resultPanel" class="result-panel">
        <div id="badgeContainer" class="badge-container">
            <span id="gradeBadge" class="grade-badge">A</span>
        </div>
        <div id="scoreDisplay" class="score-display">Calculated Score: 0%</div>
        <div id="statusText" class="status-text">Excellent</div>
</div>

<script>
document.getElementById('gradingForm').addEventListener('submit', function(event) {
    event.preventDefault();

    const inputField = document.getElementById('marksInput');
    const errorAlert = document.getElementById('errorAlert');
    const resultPanel = document.getElementById('resultPanel');
    const badgeContainer = document.getElementById('badgeContainer');
    const gradeBadge = document.getElementById('gradeBadge');
    const scoreDisplay = document.getElementById('scoreDisplay');
    const statusText = document.getElementById('statusText');
    
    const rawValue = inputField.value.trim();
    
    // Reset structural visibility states
    errorAlert.style.display = 'none';
    resultPanel.style.display = 'none';

    // 1. Structural Empty Validation
    if (rawValue === '') {
        showValidation("Input cannot be empty. Please enter a valid number.");
        return;
    }

    // 2. Type Configuration Verification
    const marks = Number(rawValue);
    if (isNaN(marks)) {
        showValidation("Invalid format. Character string inputs are strictly rejected.");
        return;
    }

    // 3. Mathematical Absolute Boundary Evaluation
    if (marks < 0 || marks > 100) {
        showValidation("Out of bounds range. Entry must scale explicitly between 0 and 100.");
        return;
    }

    // 4. Data Evaluation Pipeline & Theme Mapping
    let grade = '';
    let status = '';
    let tierClass = '';

    if (marks >= 90) {
        grade = 'A';
        status = 'Excellent Performance';
        tierClass = 'tier-a';
    } else if (marks >= 80) {
        grade = 'B';
        status = 'Very Good Standing';
        tierClass = 'tier-b';
    } else if (marks >= 70) {
        grade = 'C';
        status = 'Good / Satisfactory';
        tierClass = 'tier-c';
    } else if (marks >= 60) {
        grade = 'D';
        status = 'Passing / Marginal';
        tierClass = 'tier-d';
    } else {
        grade = 'F';
        status = 'Failing Status';
        tierClass = 'tier-f';
    }

    // 5. Dynamic Render Pipeline Configuration
    badgeContainer.className = `badge-container ${tierClass}`;
    statusText.className = `status-text text-${tierClass}`;
    
    gradeBadge.textContent = grade;
    scoreDisplay.textContent = `Calculated Score: ${marks}%`;
    statusText.textContent = status;
    
    // Render Animation Trigger
    resultPanel.style.display = 'block';
});

function showValidation(message) {
    const errorAlert = document.getElementById('errorAlert');
    errorAlert.textContent = message;
    errorAlert.style.display = 'block';
}
</script>
</body>
</html>
